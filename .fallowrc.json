{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": [
    "src/app/{__root,client,server,providers}.{ts,tsx}",
    "src/router.tsx",
    "rsbuild.config.ts",
    "content-collections.ts",
    "cloudflare.config.ts"
  ],
  "dynamicallyLoaded": [
    "src/app/blog/posts/*.mdx",
    "src/app/newsletter/issues/*.mdx"
  ],
  "ignorePatterns": [".content-collections/**", "dist/**"],
  "ignoreDependencies": ["fallow", "images", "@rsdoctor/agent-cli"],
  "ignoreUnresolvedImports": ["./src/components/**"],
  "rules": {
    "unused-files": "error",
    "unused-exports": "error",
    "unused-types": "error"
  },
  "ignoreExports": [
    {
      "file": "src/app/**/*.{ts,tsx}",
      "exports": ["Route"]
    },
    {
      "file": "src/components/uikit/Input/Input.tsx",
      "exports": ["Input"]
    }
  ]
}
